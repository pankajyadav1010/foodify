rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Menu items: readable by anyone, writable by admin only ──
    match /menu/{itemId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── Orders ──
    match /orders/{orderId} {
      // Customers can only read their own orders
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Authenticated user can create order for themselves
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      // Customers can UPDATE (cancel) only their own order,
      // and only the status / cancelReason / cancelledAt fields,
      // and only when transitioning to "Cancelled" from a cancellable status.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && resource.data.status in ["Pending", "Preparing"]
                    && request.resource.data.status == "Cancelled"
                    // Prevent tampering with other sensitive fields
                    && request.resource.data.userId   == resource.data.userId
                    && request.resource.data.total    == resource.data.total
                    && request.resource.data.items    == resource.data.items;

      // Admins can read & write all orders (requires custom claim: admin=true)
      allow read, write: if request.auth != null
                          && request.auth.token.admin == true;
    }
  }
}
